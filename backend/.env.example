APP_NAME="R.Space"
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
# Local owner-isolated PDF storage outside the repository. Defaults to %LOCALAPPDATA%\R.Space\uploads on Windows.
# UPLOAD_DIR=C:\Users\you\AppData\Local\R.Space\uploads
COOKIE_SECURE=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_SMALL=llama3.2:3b
OLLAMA_MODEL_MEDIUM=llama3.1:8b
OLLAMA_MODEL_LARGE=llama3.1:8b
OLLAMA_MODEL_VERIFY=llama3.1:8b
OLLAMA_MODEL_EMBED=nomic-embed-text
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
GROBID_URL=http://localhost:8070
LOOP_MAX_ITERATIONS=3
LOOP_WALL_CLOCK_CAP_MS=20000
LOOP_ACCEPTANCE_THRESHOLD=0.90
SOURCE_TIMEOUT_S=12
SOURCE_CACHE_TTL_S=900
SOURCE_CACHE_MAX_ENTRIES=256
SOURCE_CACHE_MAX_BYTES=33554432
SOURCE_USER_AGENT=research-assistant/0.1
RANKING_RECENCY_WEIGHT=0.0
RANKING_REMOVE_STOPWORDS=false
# OpenAlex contact is an explicit per-user choice in Settings; do not set a shared address here.
# SOURCE_CONTACT_EMAIL=your-contact@institution.edu  # Optional User-Agent for other sources only.
